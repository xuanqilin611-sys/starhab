-- --- 【4】修正済みコアロジック ---

-- A. スピード調整 (Heartbeatで確実に動作)
_G.NeonConn1 = game:GetService("RunService").Heartbeat:Connect(function()
    if not _G.NeonHubActive or _G.LastSession ~= CurrentSession then 
        if _G.NeonConn1 then _G.NeonConn1:Disconnect() end
        return 
    end
    local char = player.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if _G.SpeedEnabled and hum and hrp and hum.MoveDirection.Magnitude > 0 and not _G.IsHunting then
        hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (_G.RunSpeed / 50))
    end
end)

-- B. ワンクリック納品 (オンの時だけ作動)
_G.NeonConn2 = game:GetService("ProximityPromptService").PromptButtonHoldBegan:Connect(function(p)
    if not _G.NeonHubActive or _G.LastSession ~= CurrentSession then return end
    if _G.OneTapEnabled and not _G.IsHunting then
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local old = hrp.CFrame
            fireproximityprompt(p)
            task.wait(0.1)
            if _G.BasePos then
                hrp.CFrame = _G.BasePos
                task.wait(1.1)
                hrp.CFrame = old
            end
        end
    end
end)

-- C. 神速スキャン（プレイヤー誤爆防止・修正版）
task.spawn(function()
    local godCF = Locs["神"]
    while _G.NeonHubActive and _G.LastSession == CurrentSession do
        if _G.AutoGodEnabled and not _G.IsHunting then
            for _, v in pairs(game.Workspace:GetDescendants()) do
                if v:IsA("ProximityPrompt") then
                    -- プレイヤー内のプロンプトを完全に除外
                    local isPlayer = false
                    for _, p in pairs(game.Players:GetPlayers()) do
                        if p.Character and v:IsDescendantOf(p.Character) then
                            isPlayer = true
                            break
                        end
                    end

                    if not isPlayer then
                        local pPos = v.Parent:IsA("Model") and v.Parent:GetModelCFrame().p or (v.Parent:IsA("BasePart") and v.Parent.Position)
                        if pPos and (pPos - godCF.Position).Magnitude <= 45 then
                            _G.IsHunting = true
                            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                local old = hrp.CFrame
                                v.HoldDuration = 0
                                local st = tick()
                                while tick() - st < 2.0 and _G.NeonHubActive do
                                    hrp.CFrame = godCF * CFrame.new(0, 0.1, 0)
                                    fireproximityprompt(v)
                                    task.wait(0.1)
                                end
                                if _G.BasePos then hrp.CFrame = _G.BasePos task.wait(1.1) end
                                hrp.CFrame = old
                            end
                            _G.IsHunting = false
                            break
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)
