    if Config.OneTapEnabled and not Config.IsHunting then
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local old = hrp.CFrame
            fireproximityprompt(p)
            task.wait(0.1)
            if Config.BasePos then
                Teleport(Config.BasePos)
                task.wait(1.1)
                Teleport(old)
            end
        end
    end
end)

-- 3. AUTO GOD
--：自動周回（AUTO GOD）の監視スレッド
local GodCooldown = {}

task.spawn(function()
    local godCF = Locs["神"]
    while _G.NeonHubActive do
        if Config.AutoGodEnabled and not Config.IsHunting then
            for _, v in pairs(game.Workspace:GetDescendants()) do
                if v:IsA("ProximityPrompt") then
                    local pPos = v.Parent:IsA("Model") and v.Parent:GetModelCFrame().p
                        or (v.Parent:IsA("BasePart") and v.Parent.Position)
                    if pPos and (pPos - godCF.Position).Magnitude <= 45 then
                        local lastHit = GodCooldown[v]
                        if not lastHit or (tick() - lastHit) > 5 then
                            Config.IsHunting = true
                            GodCooldown[v] = tick()

                            local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                            if hrp then
                                v.HoldDuration = 0
                                Teleport(godCF * CFrame.new(0, 0.1, 0))
                                fireproximityprompt(v)
                                task.wait(1.0)
                                if Config.BasePos then
                                    Teleport(Config.BasePos)
                                end
                            end

                            Config.IsHunting = false
                            break
                        end
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)
