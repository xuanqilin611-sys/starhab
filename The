_G.NeonConnection1 = game:GetService("RunService").Heartbeat:Connect(function()
    if not _G.NeonHubActive then return end
    local char = player.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if Config.SpeedEnabled and hum and hrp and hum.MoveDirection.Magnitude > 0 and not Config.IsHunting then
        hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (Config.RunSpeed / 50))
    end
end)

-- ワンクリック納品
_G.NeonConnection2 = game:GetService("ProximityPromptService").PromptButtonHoldBegan:Connect(function(p)
    if not _G.NeonHubActive then return end
    if Config.OneTapEnabled and not Config.IsHunting then
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local old = hrp.CFrame
            fireproximityprompt(p)
            task.wait(0.1)
            if Config.BasePos then
                Teleport(Config.BasePos)
                task.wait(1.5)
                Teleport(old)
            end
        end
    end
end)

-- AUTO GOD
local GodCooldown = {}

task.spawn(function()
    local godCF = Locs["神"]
    while _G.NeonHubActive do
        if Config.AutoGodEnabled and not Config.IsHunting then

            local candidates = {}
            for _, v in pairs(workspace:GetDescendants()) do
                if v:IsA("ProximityPrompt") and not IsPlayerPrompt(v) then
                    local pPos = v.Parent:IsA("Model") and v.Parent:GetModelCFrame().p
                        or (v.Parent:IsA("BasePart") and v.Parent.Position)
                    if pPos and (pPos - godCF.Position).Magnitude <= 45 then
                        local lastHit = GodCooldown[v]
                        if not lastHit or (tick() - lastHit) > 5 then
                            table.insert(candidates, {prompt = v, pos = pPos})
                        end
                    end
                end
            end

            if #candidates > 0 then
                local target = candidates[1]
                local v = target.prompt
                local pPos = target.pos

                Config.IsHunting = true
                GodCooldown[v] = tick()

                local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local old = hrp.CFrame
                    v.HoldDuration = 0

                    hrp.CFrame = CFrame.new(pPos) * CFrame.new(0, 0.1, 0)
                    task.wait(0.3)
                    fireproximityprompt(v)
                    task.wait(0.3)
                    fireproximityprompt(v)

                    task.wait(1.0)
                    if Config.BasePos then
                        Teleport(Config.BasePos)
                        task.wait(1.5)
                    end
                    Teleport(old)
                end

                Config.IsHunting = false
            end
        end
        task.wait(0.1)
    end
end)
