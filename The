local function CreateJBtn()
    local sg = Instance.new("ScreenGui")
    sg.Name = "NeonJumpFix"
    sg.ResetOnSpawn = false
    sg.DisplayOrder = 999
    sg.IgnoreGuiInset = true
    sg.Parent = player.PlayerGui

    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0, 95, 0, 95)
    b.Position = UDim2.new(0.78, 0, 0.58, 0)
    b.Text = "JUMP"
    b.TextScaled = true
    b.Font = Enum.Font.GothamBold
    b.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.BackgroundTransparency = 0.2
    b.Visible = false
    b.ZIndex = 999
    b.Parent = sg
    Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)

    b.MouseButton1Click:Connect(function()
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp and Config.JumpEnabled and _G.NeonHubActive then
            hrp.Velocity = Vector3.new(hrp.Velocity.X, Config.JumpPower, hrp.Velocity.Z)
        end
    end)
    return b
end
