-- 偽ジャンプ
local function CreateJBtn()
    local old = player.PlayerGui:FindFirstChild("NeonJ")
    if old then old:Destroy() end
    local sg = Instance.new("ScreenGui", player.PlayerGui); sg.Name = "NeonJ"; sg.ResetOnSpawn = false
    local b = Instance.new("TextButton", sg); b.Size = UDim2.new(0, 95, 0, 95); b.Position = UDim2.new(0.78, 0, 0.58, 0); b.Text = "JUMP"; b.Visible = false
    Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
    b.MouseButton1Click:Connect(function()
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp and _G.JumpEnabled and _G.NeonHubActive then 
            hrp.Velocity = Vector3.new(hrp.Velocity.X, _G.JumpPower, hrp.Velocity.Z) 
        end
    end)
    return b
end
local JBtn = CreateJBtn()

PlayerTab:CreateToggle({
