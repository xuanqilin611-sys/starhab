-- --- 【1】旧プロセスの完全消去（二重起動防止） ---
local CoreGui = game:GetService("CoreGui")
if CoreGui:FindFirstChild("Rayfield") then
    CoreGui.Rayfield:Destroy()
end

_G.NeonHubActive = false
if _G.NeonConn1 then _G.NeonConn1:Disconnect() end
if _G.NeonConn2 then _G.NeonConn2:Disconnect() end
task.wait(0.2)

-- --- 【2】初期設定と変数 ---
_G.NeonHubActive = true
local CurrentSession = tick()
_G.LastSession = CurrentSession

local player = game.Players.LocalPlayer
_G.SpeedEnabled = false
_G.RunSpeed = 200
_G.JumpEnabled = false
_G.JumpPower = 100
_G.AutoGodEnabled = false
_G.OneTapEnabled = false
_G.IsHunting = false
_G.BasePos = nil

-- 各エリアの正確な座標
local Locs = {
    ["エピック"] = CFrame.new(20.79, 131.40, 1459.95),
    ["レジェンド"] = CFrame.new(41.84, 204.33, 2137.44),
    ["神聖"] = CFrame.new(-58.75, 348.91, 3288.93),
    ["秘密"] = CFrame.new(98.00, 567.35, 5276.95),
    ["神"] = CFrame.new(-17.58, 982.42, 7279.15),
    ["最後のステージ"] = CFrame.new(98.00, 567.35, 5276.95)
}

-- 基地座標の自動取得
task.spawn(function()
    while _G.NeonHubActive do
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp and not _G.BasePos then
            task.wait(2)
            _G.BasePos = hrp.CFrame
        end
        task.wait(5)
    end
end)

