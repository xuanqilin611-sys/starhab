-- マップ条件を判定する関数
local function checkMapConditions()
    if game.PlaceId ~= 0 and game.PlaceId ~= TARGET_PLACE_ID and game.GameId ~= TARGET_GAME_ID then
        return false
    end
    for _, objName in ipairs(REQUIRED_OBJECTS) do
        if not Workspace:FindFirstChild(objName) then
            return false
        end
    end
    return true
end

-- マップがロードされるのを待つ
if not game:IsLoaded() then game.Loaded:Wait() end

-- 条件に合わなければ、何も処理をせずにここでスクリプトを終了する
if not checkMapConditions() then 
    print("[Neon Hub] マップ条件が一致しないため、実行をキャンセルしました。")
