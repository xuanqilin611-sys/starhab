end)

-- --- 巻き戻しシステム ---
local positionHistory = {}
local maxHistoryFrames = 20
local lastSafeCFrame = nil
local isTeleporting = false

local function isStandingOnFloor(char, hrp)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {char}
    raycastParams.IgnoreWater = true
    local result = workspace:Raycast(hrp.Position, Vector3.new(0, -10, 0), raycastParams)
    return result and result.Instance and result.Instance:IsA("BasePart")
end

task.spawn(function()
    while _G.NeonHubActive do
        if Config.RollbackEnabled then
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 and not isTeleporting then
                local state = hum:GetState()
                if (state == Enum.HumanoidStateType.Running or state == Enum.HumanoidStateType.RunningNoPhysics) and isStandingOnFloor(char, hrp) then
                    table.insert(positionHistory, 1, hrp.CFrame)
                    if #positionHistory > maxHistoryFrames then
                        table.remove(positionHistory, #positionHistory)
                    end
                    lastSafeCFrame = positionHistory[#positionHistory]
                end
            end
        end
        task.wait(0.015)
    end
end)

player.CharacterAdded:Connect(function(newCharacter)
    if Config.RollbackEnabled and lastSafeCFrame then
        isTeleporting = true
        local hrp = newCharacter:WaitForChild("HumanoidRootPart", 5)
        local hum = newCharacter:WaitForChild("Humanoid", 5)
        if hrp and hum then
            hrp.Velocity = Vector3.new(0, 0, 0)
            hrp.CFrame = lastSafeCFrame
            task.wait(0.05)
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
        table.clear(positionHistory)
        isTeleporting = false
    end
end)

