local H, C = game:GetService("HttpService"), game:GetService("CoreGui")
local lang, sel = "en", "英語"
if C:FindFirstChild("V4T") then C.V4T:Destroy() end
local function send(t)
    local u = "https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl="..lang.."&dt=t&q="..H:UrlEncode(t)
    local s, r = pcall(function() return request and request({Url=u}).Body or game:HttpGet(u) end)
    local res = s and r:match('^%[%[%["(.-)","') or t
    res = res:gsub("\\u0027", "'"):gsub("\\u0022", '"')
    local tcs = game:GetService("TextChatService")
    if tcs.ChatVersion == Enum.ChatVersion.TextChatService then
        tcs.TextChannels.RBXGeneral:SendAsync(res)
    else
        game:GetService("ReplicatedStorage"):FindFirstChild("SayMessageRequest",true):FireServer(res,"All")
    end
end
local function c(cl, p, pr)
    local i = Instance.new(cl)
    for k, v in pairs(pr) do i[k] = v end
    i.Parent = p return i
end
