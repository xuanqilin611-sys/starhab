-- 15倍ロジック
local function runLogic()
    local last = 0
    local grabbing = false
    local ge = player:FindFirstChild("GrabNotifyEvent", true)
    local conn1 = ge and ge.Event:Connect(function(state)
        grabbing = state
        if not state then last = tick() end
    end)

    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {player.Character}
    params.FilterType = Enum.RaycastFilterType.Blacklist

    local conn2 = runService.Stepped:Connect(function()
        if not isActive then return end
        local now = tick()
        if grabbing or (now - last < 0.2) then return end

        local vSize = camera.ViewportSize
        local center = Vector2.new(vSize.X / 2, vSize.Y / 2)
        local ray = camera:ViewportPointToRay(center.X, center.Y)
        local result = workspace:Raycast(ray.Origin, ray.Direction * 150, params)

        if result and result.Instance then
            local m = result.Instance:FindFirstAncestorOfClass("Model")
            if m and m:FindFirstChild("Humanoid") and m.Name ~= player.Name then
                vu:CaptureController()
                vu:Button1Down(center)
                grabbing = true
                last = now
                task.wait()
                vu:Button1Up(center)
            end
        end
    end)
    return {conn1, conn2}
end

-- トグル動作
trigger.MouseButton1Click:Connect(function()
    isActive = not isActive
    local goalPos = isActive and UDim2.new(1, -36, 0.5, -16) or UDim2.new(0, 4, 0.5, -16)
    local goalColor = isActive and Color3.fromRGB(0, 255, 150) or Color3.fromRGB(60, 60, 60)

    tweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quart), {Position = goalPos, BackgroundColor3 = goalColor}):Play()

    if isActive then
        for i = 1, 15 do
            task.spawn(function()
                task.wait(i * 0.01)
                if isActive then table.insert(currentConns, runLogic()) end
            end)
        end
    else
        for _, c in pairs(currentConns) do
            if c[1] then c[1]:Disconnect() end
            if c[2] then c[2]:Disconnect() end
        end
        currentConns = {}
    end
end)
