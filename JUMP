SpeedInput.FocusLost:Connect(function()
    local val = tonumber(SpeedInput.Text)
    if val then currentSpeed = val; local h = Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("Humanoid"); if h then h.WalkSpeed = val end
    else SpeedInput.Text = tostring(currentSpeed) end
end)

--- ESP ---
local espOn, highlights = false, {}
local function addESP(p)
    if p == Players.LocalPlayer then return end
    p.CharacterAdded:Connect(function(c) if espOn then local h = Instance.new("Highlight", CoreGui); h.Adornee = c; highlights[p] = h end end)
    if p.Character and espOn then local h = Instance.new("Highlight", CoreGui); h.Adornee = p.Character; highlights[p] = h end
end
ESPButton.MouseButton1Click:Connect(function()
    espOn = not espOn
    ESPButton.Text = "ESP: "..(espOn and "ON" or "OFF"); ESPButton.BackgroundColor3 = espOn and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(180, 40, 40)
    for _, h in pairs(highlights) do h:Destroy() end highlights = {}
    if espOn then for _, p in pairs(Players:GetPlayers()) do addESP(p) end end
end)
Players.PlayerAdded:Connect(addESP)

--- カメラ & 中心ズレ完全防止ロジック ---
local camOn = false
local camera = workspace.CurrentCamera
local yaw, pitch = 0, 0
local moveVector = Vector3.new(0,0,0)
local moveTouch = nil
local centerPos = nil -- 移動パッドの「中心」を固定

UserInputService.InputBegan:Connect(function(input)
    if not camOn then return end
    if input.UserInputType == Enum.UserInputType.Touch and input.Position.X < (camera.ViewportSize.X / 2) then
        moveTouch = input
        centerPos = input.Position -- 触れた瞬間を「動かない中心」としてロック
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not camOn then return end
    if input.UserInputType == Enum.UserInputType.Touch then
        -- 右側：視点回転
        if input.Position.X > (camera.ViewportSize.X / 2) then
            yaw = yaw - (input.Delta.X * 0.4)
            pitch = math.clamp(pitch - (input.Delta.Y * 0.4), -85, 85)
        -- 左側：固定された中心点からの「ズレ」だけで移動方向を決める
        elseif input == moveTouch and centerPos then
            local diff = (input.Position - centerPos)
            if diff.Magnitude > 10 then -- 遊びを作る
                local rot = CFrame.Angles(0, math.rad(yaw), 0) * CFrame.Angles(math.rad(pitch), 0, 0)
                local dir = diff.Unit
                -- 【ここがキモ】カメラの正面(Look)と右(Right)を、指の倒し方にそのまま合成
                moveVector = (rot.LookVector * -dir.Y) + (rot.RightVector * dir.X)
            else
                moveVector = Vector3.new(0,0,0)
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == moveTouch then moveTouch = nil; centerPos = nil; moveVector = Vector3.new(0,0,0) end
end)

RunService.RenderStepped:Connect(function()
    if not camOn then return end
    local rot = CFrame.Angles(0, math.rad(yaw), 0) * CFrame.Angles(math.rad(pitch), 0, 0)
    -- currentSpeedに連動してカメラ移動
    camera.CFrame = CFrame.new(camera.CFrame.Position + (moveVector * (currentSpeed / 10))) * rot
end)

CamButton.MouseButton1Click:Connect(function()
    camOn = not camOn
    CamButton.Text = "CAMERA: "..(camOn and "ON" or "OFF"); CamButton.BackgroundColor3 = camOn and Color3.fromRGB(40, 180, 40) or Color3.fromRGB(40, 40, 180)
    local char = Players.LocalPlayer.Character
    if camOn then
        if char and char:FindFirstChild("HumanoidRootPart") then char.HumanoidRootPart.Anchored = true end
        camera.CameraType = Enum.CameraType.Scriptable
        pcall(function() Players.LocalPlayer.PlayerGui.TouchGui.Enabled = false end)
        local l = camera.CFrame.LookVector
        yaw, pitch = math.deg(math.atan2(-l.X, -l.Z)), math.deg(math.asin(math.clamp(l.Y, -0.99, 0.99)))
    else
        if char and char:FindFirstChild("HumanoidRootPart") then char.HumanoidRootPart.Anchored = false end
        camera.CameraType = Enum.CameraType.Custom
        pcall(function() Players.LocalPlayer.PlayerGui.TouchGui.Enabled = true end)
        camera.CameraSubject = char:FindFirstChild("Humanoid")
    end
end)
