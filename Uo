local TeleportTab = Window:CreateTab("Teleport")
for name, cf in pairs(Locs) do
    TeleportTab:CreateButton({Name = name .. " へ移動", Callback = function() Teleport(cf) end})
end
TeleportTab:CreateButton({
    Name = "自分の基地へテレポート",
    Callback = function() if Config.BasePos then Teleport(Config.BasePos) end end,
})

-- --- 実行ロジック (接続をグローバルに保存して確実に管理) ---

-- 1. スピード
_G.NeonConnection1 = game:GetService("RunService").Heartbeat:Connect(function()
    if not _G.NeonHubActive then return end
    local char = player.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    if Config.SpeedEnabled and hum and hrp and hum.MoveDirection.Magnitude > 0 and not Config.IsHunting then
        hrp.CFrame = hrp.CFrame + (hum.MoveDirection * (Config.RunSpeed / 50))
    end
end)

-- 2. ワンクリック納品
_G.NeonConnection2 = game:GetService("ProximityPromptService").PromptButtonHoldBegan:Connect(function(p)
    if not _G.NeonHubActive then return end
    if Config.OneTapEnabled and not Config.IsHunting then
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local old = hrp.CFrame
            fireproximityprompt(p)
            task.wait(0.1)
            if Config.BasePos then
                Teleport(Config.BasePos)
                task.wait(1.1)
                Teleport(old)
            end
        end
    end
end)

-- 3. AUTO GOD
task.spawn(function()
    local godCF = Locs["神"]
    while _G.NeonHubActive do
        if Config.AutoGodEnabled and not Config.IsHunting then
            for _, v in pairs(game.Workspace:GetDescendants()) do
                if v:IsA("ProximityPrompt") then
                    local pPos = v.Parent:IsA("Model") and v.Parent:GetModelCFrame().p or (v.Parent:IsA("BasePart") and v.Parent.Position)
                    if pPos and (pPos - godCF.Position).Magnitude <= 45 then
                        Config.IsHunting = true
                        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local old = hrp.CFrame; v.HoldDuration = 0
                            local st = tick()
                            while tick() - st < 2.0 and _G.NeonHubActive do 
                                Teleport(godCF * CFrame.new(0, 0.1, 0)) 
                                fireproximityprompt(v) 
                                task.wait(0.1) 
                            end
                            if Config.BasePos then Teleport(Config.BasePos) task.wait(1.1) end
                            Teleport(old)
                        end
                        Config.IsHunting = false; break
                    end
                end
            end
        end
        task.wait(0.1)
    end
end)

