-- --- 【最優先】実行中の全プロセスを強制終了 ---
_G.NeonHubActive = false
if _G.NeonConnection1 then _G.NeonConnection1:Disconnect() end
if _G.NeonConnection2 then _G.NeonConnection2:Disconnect() end

if game.CoreGui:FindFirstChild("Rayfield") then
    game.CoreGui.Rayfield:Destroy()
    task.wait(0.3)
end

-- --- 新しいセッションの開始 ---
_G.NeonHubActive = true
local player = game.Players.LocalPlayer

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Window = Rayfield:CreateWindow({
   Name = "Neon Hub",
   LoadingTitle = "Verified Logic Edition",
   ConfigurationSaving = { Enabled = false }
})

-- --- 管理データ ---
local Config = {
    RunSpeed = 200,
    SpeedEnabled = false,
    JumpEnabled = false,
    JumpPower = 100,
    AutoGodEnabled = false,
    OneTapEnabled = false,
    IsHunting = false,
    BasePos = nil
}

local Locs = {
    ["エピック"] = CFrame.new(20.79, 131.40, 1459.95),
    ["レジェンド"] = CFrame.new(41.84, 204.33, 2137.44),
    ["神聖"] = CFrame.new(-58.75, 348.91, 3288.93),
    ["秘密"] = CFrame.new(98.00, 567.35, 5276.95),
    ["神"] = CFrame.new(-17.58, 982.42, 7279.15),
    ["最後のステージ"] = CFrame.new(98.00, 567.35, 5276.95)
}

-- --- 共通関数 ---
local function Teleport(cf)
    if not _G.NeonHubActive then return end
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.Velocity = Vector3.new(0,0,0)
        hrp.CFrame = cf
    end
end

-- 基地座標の自動取得
task.spawn(function()
    while _G.NeonHubActive do
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp and not Config.BasePos then
            task.wait(2)
            Config.BasePos = hrp.CFrame
        end
        task.wait(5)
    end
end)

-- 偽ジャンプ
local function CreateJBtn()
    local old = player.PlayerGui:FindFirstChild("NeonJumpFix")
    if old then old:Destroy() end
    local sg = Instance.new("ScreenGui", player.PlayerGui); sg.Name = "NeonJumpFix"; sg.ResetOnSpawn = false
    local b = Instance.new("TextButton", sg); b.Size = UDim2.new(0, 95, 0, 95); b.Position = UDim2.new(0.78, 0, 0.58, 0); b.Text = "JUMP"; b.Visible = false
    Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
    b.MouseButton1Click:Connect(function()
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp and Config.JumpEnabled and _G.NeonHubActive then 
            hrp.Velocity = Vector3.new(hrp.Velocity.X, Config.JumpPower, hrp.Velocity.Z) 
        end
    end)
    return b
end
local JBtn = CreateJBtn()

